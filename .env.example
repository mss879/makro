# Copy to .env.local and fill in from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ^ Also what enforces the site lock (admin menu item 9, "Settings"). Without
# it the proxy cannot read the lock state, so a locked site stays PUBLIC —
# /admin/settings warns about this on screen. It fails open on purpose.
# Required in production — openssl rand -hex 32. Left unset, visitor hashes
# fall back to a public dev salt anyone could recompute.
PAGEVIEW_HASH_SALT=

# Canonical origin. OPTIONAL — leave blank in production.
#
# lib/site.ts already defaults to https://makrodevelopers.com, and that default
# is what every canonical link, the sitemap, robots.txt, Open Graph URL and
# schema.org @id is built from. Set this ONLY on a staging or preview
# deployment that should advertise its own https origin rather than claim to
# be production.
#
# Anything that is not a valid https:// origin is ignored — including the
# http://localhost:3000 that local .env files carry — so a production build run
# from a developer machine can never ship localhost canonicals.
NEXT_PUBLIC_SITE_URL=

# --- AI chat agent (admin menu item 8, "Chat") -------------------------------
# The website assistant that answers visitor questions and captures leads into
# the CRM. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_CHAT_MODEL=

# Testing only. `stub` swaps the language model for a deterministic scripted
# one so the chat pipeline — persistence, lead capture, the CRM write, human
# takeover — can be exercised without a key. Never set this in production.
CHAT_PROVIDER=

